# Required for local development and Railway production
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=replace-with-a-long-random-secret
CLERK_PUBLISHABLE_KEY=pk_live_or_test_replace_me
CLERK_SECRET_KEY=sk_live_or_test_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_live_or_test_replace_me
BASE_PATH=/

# Stripe uses the attached Replit connection. No Stripe API key or webhook
# signing secret is required (or supported) in the current Replit-connected
# environment. Billing upgrades depend on that Replit connector until a
# non-Replit Stripe integration is added.
